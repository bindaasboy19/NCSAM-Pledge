# ==============================================================================
# SECURITY NOTICE:
# Anything prefixed with VITE_ is exposed to the browser and must contain public configuration only.
# NEVER put private keys, database credentials, API secrets, or internal tokens here.
# ==============================================================================

# Base URL for the Java Spring Boot backend service
VITE_API_BASE_URL=http://localhost:8080

# When true, if the Spring Boot backend is offline or unreachable during local development,
# the frontend provides an isolated development preview without breaking the UI flow.
# Set to false to strictly require the live Spring Boot server.
VITE_ENABLE_DEV_MOCK_FALLBACK=true
