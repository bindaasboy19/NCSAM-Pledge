# ==============================================================================
# SECURITY NOTICE:
# Anything prefixed with VITE_ is exposed to the browser and must contain public configuration only.
# NEVER put private keys, database credentials, API secrets, or internal tokens here.
# ==============================================================================

# Production Spring Boot backend API endpoint
VITE_API_BASE_URL=https://cyber-awareness-backend.onrender.com

# Production public site domain
VITE_PUBLIC_SITE_URL=https://ncsam-pledge.vercel.app


# Strictly false in production - never mock in production
VITE_ENABLE_DEV_MOCK_FALLBACK=false
